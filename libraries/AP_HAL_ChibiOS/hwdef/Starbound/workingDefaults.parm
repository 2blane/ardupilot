# SERIAL1 is RTK GPS
SERIAL1_PROTOCOL 5
SERIAL1_BAUD 115

# SERIAL2 is used for OLED screen
SERIAL2_PROTOCOL 2
SERIAL2_BAUD 115

# SERIAL3 is used for Radio
SERIAL3_PROTOCOL 2
SERIAL3_BAUD 57

# SERIAL4 is used for ESP32
SERIAL4_PROTOCOL 2
SERIAL4_BAUD 115

# Frame Setup
FRAME_CLASS 1
FRAME_TYPE 1

# Motor outputs: PWM1–4 => SERVO1–4
SERVO1_FUNCTION 33
SERVO2_FUNCTION 36
SERVO3_FUNCTION 35
SERVO4_FUNCTION 34

# DShot ESC settings
MOT_PWM_TYPE 6
SERVO_BLH_AUTO 1
SERVO_BLH_BDMASK 15
SERVO_BLH_OTYPE 0
SERVO_BLH_POLES 12
SERVO_DSHOT_ESC 2
SERVO_DSHOT_RATE 0

# Spin settings (adjust as needed)
MOT_SPIN_ARM 0.1
MOT_SPIN_MIN 0.15
MOT_SAFE_DISARM 0

# Arming checks
ARMING_CHECK 1

# Output range (safe for BLHeli_S)
SERVO1_MIN 1000
SERVO1_MAX 2000
SERVO2_MIN 1000
SERVO2_MAX 2000
SERVO3_MIN 1000
SERVO3_MAX 2000
SERVO4_MIN 1000
SERVO4_MAX 2000

SERVO1_TRIM 1000
SERVO2_TRIM 1000
SERVO3_TRIM 1000
SERVO4_TRIM 1000

SERVO5_FUNCTION 120
SHOW_LED0_CHAN 5
SHOW_LED0_TYPE 10
SHOW_LED0_COUNT 3
SHOW_LED0_GAMMA,1
SHOW_LED0_WTEMP,0

AHRS_ORIENTATION 6
COMPASS_ORIENT 6